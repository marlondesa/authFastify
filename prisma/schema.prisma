generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String         @id @default(uuid())
  name                     String
  email                    String         @map("email")
  password                 String
  isEmailVerified          Boolean        @default(false) @map("is_email_verified")
  emailVerifyToken         String?        @unique @map("email_verify_token")
  emailVerifyTokenExpiresAt DateTime?     @map("email_verify_token_expires_at")
  passwordResetToken       String?        @unique @map("password_reset_token")
  passwordResetExpiresAt   DateTime?      @map("password_reset_expires_at")
  deletedAt                DateTime?      @map("deleted_at")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  refreshTokens            RefreshToken[]

  @@unique([email, deletedAt])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique @map("token_hash")
  tokenFamily String   @map("token_family")
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenFamily])
  @@map("refresh_tokens")
}